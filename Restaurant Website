<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Food Menu</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-orange-50">

    <!-- Header -->
    <header class="text-center py-10 bg-orange-600 text-white">
        <h1 class="text-4xl font-bold">🍴 Tasty Bites</h1>
        <p class="mt-2 text-lg">Delicious food, made with love ❤️</p>
    </header>

    <!-- Menu Section -->
    <section class="max-w-6xl mx-auto px-6 py-12">

        <div class="text-center mb-10">
            <h2 class="text-3xl font-bold text-gray-800">Our Popular Dishes</h2>
            <p class="text-gray-600 mt-2">
                Explore our customer's favorite dishes
            </p>
        </div>

        <!-- Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

            <!-- Card 1 -->
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl hover:-translate-y-2 transition duration-300">
                <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&w=800&q=80"
                     class="w-full h-52 object-cover"
                     alt="Pizza">

                <div class="p-5">
                    <h3 class="text-2xl font-bold text-gray-800">Cheese Pizza</h3>

                    <p class="text-gray-600 mt-2">
                        Crispy crust topped with rich cheese, fresh vegetables
                        and delicious herbs.
                    </p>

                    <div class="flex justify-between items-center mt-5">
                        <span class="text-xl font-bold text-orange-600">₹249</span>
                        <button class="bg-orange-600 text-white px-5 py-2 rounded-full hover:bg-orange-700 transition">
                            Order Now
                        </button>
                    </div>
                </div>
            </div>


            <!-- Card 2 -->
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl hover:-translate-y-2 transition duration-300">
                <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=800&q=80"
                     class="w-full h-52 object-cover"
                     alt="Burger">

                <div class="p-5">
                    <h3 class="text-2xl font-bold text-gray-800">Classic Burger</h3>

                    <p class="text-gray-600 mt-2">
                        Juicy grilled patty with fresh lettuce, tomato, cheese
                        and our special sauce.
                    </p>

                    <div class="flex justify-between items-center mt-5">
                        <span class="text-xl font-bold text-orange-600">₹199</span>
                        <button class="bg-orange-600 text-white px-5 py-2 rounded-full hover:bg-orange-700 transition">
                            Order Now
                        </button>
                    </div>
                </div>
            </div>


            <!-- Card 3 -->
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl hover:-translate-y-2 transition duration-300">
                <img src="https://tse3.mm.bing.net/th/id/OIP.9lbRV_dBZ9NR-Bi3qBqEHwHaHa?r=0&pid=Api&h=220&P=0"
                     class="w-full h-52 object-cover"
                     alt="Pasta">

                <div class="p-5">
                    <h3 class="text-2xl font-bold text-gray-800">Creamy Pasta</h3>

                    <p class="text-gray-600 mt-2">
                        Soft pasta tossed in creamy white sauce with herbs
                        and fresh vegetables.
                    </p>

                    <div class="flex justify-between items-center mt-5">
                        <span class="text-xl font-bold text-orange-600">₹229</span>
                        <button class="bg-orange-600 text-white px-5 py-2 rounded-full hover:bg-orange-700 transition">
                            Order Now
                        </button>
                    </div>
                </div>
            </div>


            <!-- Card 4 -->
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl hover:-translate-y-2 transition duration-300">
                <img src="https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=800&q=80"
                     class="w-full h-52 object-cover"
                     alt="Samosa">

                <div class="p-5">
                    <h3 class="text-2xl font-bold text-gray-800">Crispy Samosa</h3>

                    <p class="text-gray-600 mt-2">
                        Golden crispy samosas filled with spicy potatoes
                        and aromatic Indian spices.
                    </p>

                    <div class="flex justify-between items-center mt-5">
                        <span class="text-xl font-bold text-orange-600">₹99</span>
                        <button class="bg-orange-600 text-white px-5 py-2 rounded-full hover:bg-orange-700 transition">
                            Order Now
                        </button>
                    </div>
                </div>
            </div>


            <!-- Card 5 -->
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl hover:-translate-y-2 transition duration-300">
                <img src="https://images.unsplash.com/photo-1601050690117-94f5f6fa8bd7?auto=format&fit=crop&w=800&q=80"
                     class="w-full h-52 object-cover"
                     alt="Paneer">

                <div class="p-5">
                    <h3 class="text-2xl font-bold text-gray-800">Paneer Tikka</h3>

                    <p class="text-gray-600 mt-2">
                        Soft paneer cubes marinated with spices and grilled
                        to perfection.
                    </p>

                    <div class="flex justify-between items-center mt-5">
                        <span class="text-xl font-bold text-orange-600">₹279</span>
                        <button class="bg-orange-600 text-white px-5 py-2 rounded-full hover:bg-orange-700 transition">
                            Order Now
                        </button>
                    </div>
                </div>
            </div>


            <!-- Card 6 -->
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl hover:-translate-y-2 transition duration-300">
                <img src="https://images.unsplash.com/photo-1551024601-bec78aea704b?auto=format&fit=crop&w=800&q=80"
                     class="w-full h-52 object-cover"
                     alt="Dessert">

                <div class="p-5">
                    <h3 class="text-2xl font-bold text-gray-800">Chocolate Dessert</h3>

                    <p class="text-gray-600 mt-2">
                        A rich and delicious chocolate dessert perfect for
                        ending your meal.
                    </p>

                    <div class="flex justify-between items-center mt-5">
                        <span class="text-xl font-bold text-orange-600">₹149</span>
                        <button class="bg-orange-600 text-white px-5 py-2 rounded-full hover:bg-orange-700 transition">
                            Order Now
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-900 text-white text-center py-5">
        <p>© 2026 Tasty Bites | Deliciousness at every bite 🍽️</p>
    </footer>

</body>
</html>
