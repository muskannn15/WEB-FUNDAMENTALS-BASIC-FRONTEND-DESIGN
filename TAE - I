<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tech Quiz Arena</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    /* Hide page radio controls */
    input[name="page"] {
      display: none;
    }

    /* Hide all pages initially */
    .page {
      display: none;
    }

    /* =========================
       PAGE NAVIGATION
    ========================== */

    #home:checked ~ .app .home-page {
      display: flex;
    }

    #html1:checked ~ .app .html1-page {
      display: flex;
    }

    #html2:checked ~ .app .html2-page {
      display: flex;
    }

    #html3:checked ~ .app .html3-page {
      display: flex;
    }

    #html4:checked ~ .app .html4-page {
      display: flex;
    }

    #html5:checked ~ .app .html5-page {
      display: flex;
    }

    #html-score:checked ~ .app .html-score-page {
      display: flex;
    }

    #tailwind1:checked ~ .app .tailwind1-page {
      display: flex;
    }

    #tailwind2:checked ~ .app .tailwind2-page {
      display: flex;
    }

    #tailwind3:checked ~ .app .tailwind3-page {
      display: flex;
    }

    #tailwind4:checked ~ .app .tailwind4-page {
      display: flex;
    }

    #tailwind5:checked ~ .app .tailwind5-page {
      display: flex;
    }

    #tailwind-score:checked ~ .app .tailwind-score-page {
      display: flex;
    }

    /* =========================
       TIMER
    ========================== */

    @keyframes timer {
      from {
        width: 100%;
      }

      to {
        width: 0%;
      }
    }

    .timer-bar {
      width: 100%;
    }

    #html1:checked ~ .app .html1-page .timer-bar,
    #html2:checked ~ .app .html2-page .timer-bar,
    #html3:checked ~ .app .html3-page .timer-bar,
    #html4:checked ~ .app .html4-page .timer-bar,
    #html5:checked ~ .app .html5-page .timer-bar,
    #tailwind1:checked ~ .app .tailwind1-page .timer-bar,
    #tailwind2:checked ~ .app .tailwind2-page .timer-bar,
    #tailwind3:checked ~ .app .tailwind3-page .timer-bar,
    #tailwind4:checked ~ .app .tailwind4-page .timer-bar,
    #tailwind5:checked ~ .app .tailwind5-page .timer-bar {
      animation: timer 30s linear forwards;
    }

    /* =========================
       FEEDBACK
    ========================== */

    .feedback {
      display: none;
    }

    .question:has(input.correct:checked) .correct-feedback {
      display: block;
    }

    .question:has(input.wrong:checked) .wrong-feedback {
      display: block;
    }

    /* =========================
       NEXT BUTTON
    ========================== */

    .next-btn {
      display: none;
    }

    .question:has(input[type="radio"]:checked) .next-btn {
      display: inline-flex;
    }

    /* =========================
       OPTION EFFECTS
    ========================== */

    .option {
      transition: all 0.25s ease;
    }

    .option:hover {
      transform: translateY(-3px);
    }

    .option:has(input:checked) {
      border-color: rgb(99 102 241);
      background: rgba(99, 102, 241, 0.15);
    }

    .option:has(input.correct:checked) {
      border-color: rgb(16 185 129);
      background: rgba(16, 185, 129, 0.15);
    }

    .option:has(input.wrong:checked) {
      border-color: rgb(244 63 94);
      background: rgba(244, 63, 94, 0.15);
    }

    /* Glass effect */
    .glass {
      background: rgba(30, 41, 59, 0.72);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(148, 163, 184, 0.15);
    }

    /* Background */
    body {
      background:
        radial-gradient(circle at top left, rgba(79, 70, 229, 0.25), transparent 35%),
        radial-gradient(circle at bottom right, rgba(14, 165, 233, 0.15), transparent 35%),
        #020617;
    }
  </style>
</head>

