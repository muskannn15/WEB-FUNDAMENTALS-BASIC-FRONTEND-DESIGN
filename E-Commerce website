<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Showcase</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100">

    <!-- Header -->
    <header class="bg-gray-900 text-white p-5">
        <div class="max-w-6xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-3">
            <h1 class="text-2xl font-bold">✨ NovaStore</h1>

           
        </div>
    </header>

    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-600 to-purple-600 text-white text-center py-12 px-5">
        <h2 class="text-4xl font-bold mb-3">New Collection 2026</h2>
        <p class="text-lg mb-6">
            Discover stylish products made for your everyday life.
        </p>

        <button class="bg-white text-blue-600 px-6 py-3 rounded-full font-semibold hover:bg-gray-200">
            Shop Now
        </button>
    </section>

    <!-- Products -->
    <section class="max-w-6xl mx-auto px-5 py-10">

        <h2 class="text-3xl font-bold text-center mb-8">
            Featured Products
        </h2>

        <!-- Flexbox Product Container -->
        <div class="flex flex-col sm:flex-row flex-wrap justify-center gap-6">

            <!-- Product 1 -->
            <div class="bg-white rounded-xl shadow-lg overflow-hidden
                        w-full sm:w-72 hover:scale-105 transition">

                <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30"
                     class="w-full h-56 object-cover"
                     alt="Smart Watch">

                <div class="p-5">
                    <h3 class="text-xl font-bold">Smart Watch</h3>
                    <p class="text-gray-500 mt-2">
                        Modern smartwatch with fitness features.
                    </p>

                    <div class="flex justify-between items-center mt-5">
                        <span class="text-xl font-bold text-blue-600">1499Rs</span>
                        <button class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
                            Buy Now
                        </button>
                    </div>
                </div>
            </div>

            <!-- Product 2 -->
            <div class="bg-white rounded-xl shadow-lg overflow-hidden
                        w-full sm:w-72 hover:scale-105 transition">

                <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e"
                     class="w-full h-56 object-cover"
                     alt="Headphones">

                <div class="p-5">
                    <h3 class="text-xl font-bold">Wireless Headphones</h3>
                    <p class="text-gray-500 mt-2">
                        Enjoy clear sound with a stylish design.
                    </p>

                    <div class="flex justify-between items-center mt-5">
                        <span class="text-xl font-bold text-blue-600">999Rs</span>
                        <button class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
                            Buy Now
                        </button>
                    </div>
                </div>
            </div>

            <!-- Product 3 -->
            <div class="bg-white rounded-xl shadow-lg overflow-hidden
                        w-full sm:w-72 hover:scale-105 transition">

                <img src="https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f"
                     class="w-full h-56 object-cover"
                     alt="Camera">

                <div class="p-5">
                    <h3 class="text-xl font-bold">Digital Camera</h3>
                    <p class="text-gray-500 mt-2">
                        Capture your favorite moments in high quality.
                    </p>

                    <div class="flex justify-between items-center mt-5">
                        <span class="text-xl font-bold text-blue-600">1999Rs</span>
                        <button class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
                            Buy Now
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-900 text-white text-center p-5">
        <p>© 2026 NovaStore | All Rights Reserved</p>
    </footer>

</body>
</html>
